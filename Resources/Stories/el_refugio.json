        {
            "id": "inicio",
            "characterName": "Tú",
            "dialogue": "La tormenta ruge afuera. Has encontrado una cabaña vieja en medio del bosque. La puerta cruje al abrirse. Adentro, una vela parpadea sobre una mesa polvorienta. Hay un pasillo oscuro, una escalera al sótano y una puerta trasera que da al jardín.",
            "backgroundImage": "cabin_entrance",
            "bgMusic": "ambient_horror",
            "choices": [
                {
                    "id": "ir_pasillo",
                    "text": "Explorar el pasillo oscuro",
